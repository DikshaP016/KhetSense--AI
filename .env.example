# Google Earth Engine Credentials
# Stored at credentials/ee-key.json

# NASA Earthdata Login (SMAP SPL3SMP_E)
EARTHDATA_USERNAME=your_earthdata_username
EARTHDATA_PASSWORD=your_earthdata_password

# OpenWeather API
OPENWEATHER_API_KEY=your_openweather_api_key

# Supabase PostgreSQL Database with PostGIS
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres

# Meta WhatsApp Cloud API (Permanent System User Token)
WHATSAPP_TOKEN=your_permanent_system_user_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id_here
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_custom_webhook_verify_token_here

# Meta App Secret (used to verify incoming X-Hub-Signature-256 HMAC-SHA256 headers; fails closed if unset)
META_APP_SECRET=your_meta_app_secret_here

# WhatsApp Outbound Kill-Switch: Set to 'true' to allow outbound messages; default 'false' suppresses network calls
ENABLE_OUTBOUND_WHATSAPP=false

# Automatic Advisory Generation on Registration: Set to 'true' to dispatch advisory upon onboarding; default 'false'
AUTO_DISPATCH_ADVISORY_ON_REGISTRATION=false

# Recipient Phone Allowlist (deny-by-default when enabled, comma-separated E.164 without '+')
WHATSAPP_ALLOWLIST_ENABLED=false
WHATSAPP_ALLOWED_NUMBERS=your_test_numbers_here

# Multilingual Voice Advisory & Text-to-Speech (TTS)
# Set to 'true' to automatically generate and send voice note alongside text advisory
ENABLE_VOICE_ADVISORY=false

# Provider options:
# - 'mock': Offline, deterministic mock generator (default, zero-dependency, safe for local testing)
# - 'google': Google Cloud Text-to-Speech REST API (supports en-IN, mr-IN, hi-IN neural/wavenet voices)
# - 'edge': Microsoft Edge Neural TTS via edge-tts (free high-quality neural voices)
TTS_PROVIDER=mock

# Google Cloud Text-to-Speech Credentials (required only if TTS_PROVIDER=google)
# Either provide an API key or point to a service account JSON file:
GOOGLE_TTS_API_KEY=your_google_cloud_tts_api_key_here
# GOOGLE_APPLICATION_CREDENTIALS=credentials/ee-key.json

# Audio format for WhatsApp media upload (options: 'mp3', 'ogg'; default: 'mp3')
TTS_AUDIO_FORMAT=mp3

# Temporary directory for caching generated audio files before WhatsApp upload
TTS_CACHE_DIR=./tmp/audio_cache
